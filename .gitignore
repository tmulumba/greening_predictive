# Full data supplied privately; never commit these files.
data/source/**
!data/source/README.md
data/downloads/
data/raw/
data/interim/
data/derived/

# Generated output and caches.
outputs/**
!outputs/.gitkeep
cache/
caches/

# Dataset-format safety net. The reference sample is the one deliberate exception.
*.parquet
*.pq
*.feather
*.arrow
*.npy
*.npz
*.gpkg
*.shp
*.shx
*.dbf
*.cpg
*.prj
*.tif
*.tiff
*.zip
*.7z
*.tar
*.gz
!data/sample/evergreen_reference_sample.parquet

# Python, notebooks, environments, and operating-system files.
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.DS_Store

# Secrets and local configuration.
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*
*token*

# Author-side build utility; not part of the intern task.
_build_repository_data.py
